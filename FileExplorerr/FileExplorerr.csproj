<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- LibVLC: motor de video -->
    <PackageReference Include="LibVLCSharp" Version="3.9.7.1" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.3" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260526" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260526" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />

    <!-- Reproductor de música -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="taglib-sharp-netstandard2.0" Version="2.1.0" />

    <!-- Base de datos -->
    <PackageReference Include="Npgsql" Version="9.0.2" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />

    <!--
      PHASE 1-2: Native Office export (replaces Python / export_office.py)

      ClosedXML 0.102.2 was built against DocumentFormat.OpenXml 2.x.
      Pinning to 2.20.0 prevents the TypeLoadException caused by the
      IdPartPair struct/class mismatch introduced in OpenXml 3.x.

      When upgrading ClosedXML in the future, check its release notes
      to find the matching DocumentFormat.OpenXml version before bumping.
    -->
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />

    <!-- Script Python para exportacion Word/PowerPoint/PDF (eliminado en Fase 5) -->
    <None Update="export_office.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>