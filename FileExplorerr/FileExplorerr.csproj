<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- LibVLC: motor de video -->
    <PackageReference Include="LibVLCSharp" Version="3.9.7.1" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.3" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260526" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260526" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />

    <!-- Reproductor de música -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="taglib-sharp-netstandard2.0" Version="2.1.0" />

    <!-- Base de datos -->
    <PackageReference Include="Npgsql" Version="9.0.2" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />

    <!--
      Office export — native C# (Phases 2-5, replaces export_office.py)
      ClosedXML 0.102.2 requires DocumentFormat.OpenXml 2.x (not 3.x).
    -->
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />

    <!--
      Phase 5: PDF export — QuestPDF Community MIT license.
      Free for individuals and organizations under $1M annual revenue.
      License configured in Program.cs: QuestPDF.Settings.License = LicenseType.Community
    -->
    <PackageReference Include="QuestPDF" Version="2024.12.0" />

    <!--
      export_office.py is no longer needed — all formats are now handled
      by native C# exporters.  Remove this entry in Phase 5 cleanup.
    -->
    <None Update="export_office.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>